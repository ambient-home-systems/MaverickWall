{
  "name": "@maverick-wall/server",
  "version": "0.54.2",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "add-source": "node dist/tools/add-source.js",
    "add-screen": "node dist/tools/add-screen.js",
    "add-wall": "node dist/tools/add-screen.js",
    "diagnose": "node dist/tools/diagnose-source.js",
    "enable-shift": "node dist/tools/enable-shift.js",
    "analyse-titles": "node dist/tools/analyse-titles.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@material/material-color-utilities": "^0.3.0",
    "@maverick-wall/calendar": "workspace:*",
    "@maverick-wall/core": "workspace:*",
    "better-auth": "^1.2.0",
    "better-sqlite3": "^11.3.0",
    "bonjour-service": "^1.4.4",
    "drizzle-orm": "^0.45.2",
    "hono": "~4.12.34",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.31.4",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20.11"
  },
  "license": "AGPL-3.0-or-later"
}
