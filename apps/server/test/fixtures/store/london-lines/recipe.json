{
  "name": "London line status",
  "contract": 1,
  "config": [
    {
      "key": "mode",
      "label": "Which lines",
      "type": "select",
      "options": [
        {
          "value": "tube",
          "label": "Underground"
        },
        {
          "value": "elizabeth-line",
          "label": "Elizabeth line"
        },
        {
          "value": "overground",
          "label": "Overground"
        },
        {
          "value": "dlr",
          "label": "DLR"
        },
        {
          "value": "tram",
          "label": "Trams"
        }
      ],
      "default": "tube"
    }
  ],
  "secrets": [],
  "fetch": {
    "url": "https://api.tfl.gov.uk/Line/Mode/{mode}/Status",
    "intervalSeconds": 300,
    "allowLan": false,
    "format": "json"
  },
  "panel": {
    "kind": "readings",
    "title": "Lines",
    "items": {
      "for": ".",
      "label": "{name}",
      "value": "{lineStatuses[0].statusSeverityDescription}",
      "limit": 12,
      "empty": "Transport for London lists no lines of this kind.",
      "tone": {
        "from": "lineStatuses[0].statusSeverity",
        "map": {
          "9": "active",
          "10": "idle",
          "18": "idle",
          "19": "idle"
        },
        "default": "alert"
      }
    }
  },
  "signals": []
}
