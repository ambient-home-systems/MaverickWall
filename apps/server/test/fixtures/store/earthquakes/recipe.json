{
  "name": "Earthquakes",
  "contract": 1,
  "config": [
    {
      "key": "feed",
      "label": "Which quakes",
      "type": "select",
      "options": [
        {
          "value": "significant_week",
          "label": "Significant, past week"
        },
        {
          "value": "4.5_day",
          "label": "4.5 and over, past day"
        },
        {
          "value": "4.5_week",
          "label": "4.5 and over, past week"
        },
        {
          "value": "2.5_day",
          "label": "2.5 and over, past day"
        }
      ],
      "default": "4.5_day"
    }
  ],
  "secrets": [],
  "fetch": {
    "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/{feed}.geojson",
    "intervalSeconds": 600,
    "allowLan": false,
    "format": "json"
  },
  "panel": {
    "kind": "readings",
    "title": "Earthquakes",
    "items": {
      "for": "features",
      "label": "{properties.place | truncate:40}",
      "value": "M{properties.mag | round:1} · {properties.time | time}",
      "sort": {
        "by": "properties.mag",
        "order": "desc",
        "as": "number"
      },
      "limit": 5,
      "empty": "No earthquakes this size.",
      "tone": {
        "from": "properties.alert",
        "map": {
          "red": "alert",
          "orange": "alert",
          "yellow": "active"
        }
      }
    }
  },
  "signals": []
}
