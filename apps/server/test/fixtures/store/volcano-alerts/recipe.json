{
  "name": "Volcano alerts",
  "contract": 1,
  "config": [],
  "secrets": [],
  "fetch": {
    "url": "https://volcanoes.usgs.gov/hans-public/api/volcano/getElevatedVolcanoes",
    "intervalSeconds": 3600,
    "allowLan": false,
    "format": "json"
  },
  "lookups": {
    "colour": {
      "YELLOW": "Advisory",
      "ORANGE": "Watch",
      "RED": "Warning",
      "GREEN": "Normal"
    }
  },
  "panel": {
    "kind": "readings",
    "title": "Volcanoes",
    "items": {
      "for": ".",
      "label": "{volcano_name}",
      "value": "{color_code | map:colour}",
      "sort": {
        "by": "sent_unixtime",
        "order": "desc",
        "as": "number"
      },
      "limit": 6,
      "empty": "Every US volcano is at normal.",
      "tone": {
        "from": "color_code",
        "map": {
          "RED": "alert",
          "ORANGE": "alert",
          "YELLOW": "active"
        },
        "default": "idle"
      }
    }
  },
  "signals": []
}
