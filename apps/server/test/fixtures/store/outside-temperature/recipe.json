{
  "name": "Outside temperature",
  "contract": 1,
  "config": [
    {
      "key": "lat",
      "label": "Latitude",
      "type": "string",
      "default": "51.5074"
    },
    {
      "key": "lon",
      "label": "Longitude",
      "type": "string",
      "default": "-0.1278"
    }
  ],
  "secrets": [],
  "fetch": {
    "url": "https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m",
    "intervalSeconds": 900,
    "allowLan": false,
    "format": "json"
  },
  "panel": {
    "kind": "stat",
    "title": "Outside",
    "value": "{current.temperature_2m | round:1}",
    "caption": "°C"
  },
  "signals": []
}
