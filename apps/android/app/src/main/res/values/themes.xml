<?xml version="1.0" encoding="utf-8"?>
<!--
  AppCompat-based, because KioskActivity is an AppCompatActivity and its theme
  must descend from Theme.AppCompat. The setup screen draws with Compose over
  the same theme. Dark by default to match the wall (Board), so there is no
  light flash before the WebView paints.
-->
<resources>
    <style name="Theme.MaverickWall" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/wall_accent</item>
        <item name="colorPrimaryDark">@color/wall_background</item>
        <item name="colorAccent">@color/wall_accent</item>
        <item name="android:windowBackground">@color/wall_background</item>
        <item name="android:colorBackground">@color/wall_background</item>
        <item name="android:statusBarColor">@color/wall_background</item>
        <item name="android:navigationBarColor">@color/wall_background</item>
    </style>

    <!-- The kiosk: no title bar, dark ground. The system bars are hidden in
         code (immersive-sticky) so the wall fills the panel edge to edge. -->
    <style name="Theme.MaverickWall.Fullscreen" parent="Theme.MaverickWall">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
