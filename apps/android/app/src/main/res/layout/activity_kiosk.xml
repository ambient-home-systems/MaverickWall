<?xml version="1.0" encoding="utf-8"?>
<!--
  The wall is the WebView; the connecting status sits on top of it and is shown
  only when even the disk cache cannot draw (rule nine, layer three). Keeping
  both in one frame means the status can appear and vanish without tearing down
  the WebView underneath, so a recovered load is instant.

  The status is Compose (`ConnectingScreen`) rather than views, so it can be
  drawn the right way up on a television hung on its end with the remote's
  arrows still moving the way they look — see `Rotated`. The WebView is never
  turned here: the wall turns itself, in the page, from its own settings.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wall_background">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The native "connecting…" status. Branded, never blank. Starts hidden;
         the activity shows it on a cold boot and on a load that cannot fall
         back to cache. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/connecting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wall_background"
        android:visibility="gone" />
</FrameLayout>
