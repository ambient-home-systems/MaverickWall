{
  "name": "@maverick-wall/core",
  "version": "0.1.0",
  "description": "Pure domain logic and ports for Maverick Wall. No I/O, no framework.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck:offline": "tsc -p tsconfig.offline.json"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.11"
  }
}
