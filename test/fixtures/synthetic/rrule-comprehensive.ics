BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Maverick Wall//Synthetic Fixture//EN
X-WR-CALNAME:RRULE coverage
BEGIN:VEVENT
UID:freq-daily@synthetic
SUMMARY:Daily count 3
DTSTART;TZID=America/New_York:20260105T090000
DTEND;TZID=America/New_York:20260105T093000
RRULE:FREQ=DAILY;COUNT=3
END:VEVENT
BEGIN:VEVENT
UID:interval-byday@synthetic
SUMMARY:Every other week Mon and Wed
DTSTART;TZID=America/New_York:20260105T110000
DTEND;TZID=America/New_York:20260105T113000
RRULE:FREQ=WEEKLY;INTERVAL=2;BYDAY=MO,WE;COUNT=6
END:VEVENT
BEGIN:VEVENT
UID:bymonthday@synthetic
SUMMARY:Fifteenth of the month
DTSTART;TZID=America/New_York:20260115T140000
DTEND;TZID=America/New_York:20260115T143000
RRULE:FREQ=MONTHLY;BYMONTHDAY=15;COUNT=3
END:VEVENT
BEGIN:VEVENT
UID:bysetpos@synthetic
SUMMARY:Last weekday of the month
DTSTART;TZID=America/New_York:20260130T160000
DTEND;TZID=America/New_York:20260130T163000
RRULE:FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-1;COUNT=3
END:VEVENT
BEGIN:VEVENT
UID:until@synthetic
SUMMARY:Weekly until a UTC instant
DTSTART;TZID=America/New_York:20260106T080000
DTEND;TZID=America/New_York:20260106T083000
RRULE:FREQ=WEEKLY;UNTIL=20260127T130000Z
END:VEVENT
